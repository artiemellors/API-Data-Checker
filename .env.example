# API Checker Configuration (all vars use AC_ prefix)
# Copy to .env and adjust as needed

AC_HEADLESS=true
AC_BROWSER_TIMEOUT_MS=30000
AC_PAGE_LOAD_WAIT_MS=5000
AC_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36

AC_HTTP_TIMEOUT_S=15.0
AC_HTTP_MAX_RETRIES=3
AC_HTTP_CONCURRENCY=5
AC_RATE_LIMIT_DELAY_S=0.5

AC_DB_PATH=retailer_checker.db
AC_OUTPUT_DIR=./output
AC_LOG_LEVEL=INFO

# Optional proxy (e.g. http://user:pass@host:port)
# AC_HTTP_PROXY=
